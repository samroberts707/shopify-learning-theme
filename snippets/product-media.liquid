{% case media.media_type %}
    {% when 'image' %}
        {% render 'image',
            class: 'w-full h-full object-cover',
            image: media,
            width: 1100,
            height: 1100,
            crop: 'center'
        %}
    {% when 'external_video' %}
        {{ media | external_video_tag: class: "w-full h-80 object-cover" }}
    {% when 'video' %}
        {{ media | video_tag: controls: true, class: "w-full h-full object-cover" }}
    {% when "model" %}
        {{ media | model_viewer_tag }}
    {% else %}
        {{ media | media_tag }}
{% endcase %}