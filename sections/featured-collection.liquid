{% for item in section.settings.featured_collection.products %}
    {% render 'product-card', product: item %}
{% endfor %}


{% schema %}
{
    "name": "Featured Collection",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "default": "Featured Collection",
            "label": "Title"
        },
        {
            "type": "collection",
            "id": "featured_collection",
            "label": "Collection"
        }
    ]
}
{% endschema %}